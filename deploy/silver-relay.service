[Unit]
Description=Silver Messenger relay (stores and forwards encrypted envelopes)
Documentation=https://github.com/IAmForeverAloneToo/Silver-Messenger
After=network-online.target
Wants=network-online.target

[Service]
User=silver
Group=silver
EnvironmentFile=-/etc/silver-relay/relay.env
# Database lives in /var/lib/silver-relay (exposed as STATE_DIRECTORY),
# readable by the relay's user only: it holds every mailbox and key bundle.
StateDirectory=silver-relay
StateDirectoryMode=0700
# The admin socket lives in /run/silver-relay, for the relay's user and root.
RuntimeDirectory=silver-relay
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/silver-relay
Restart=always
RestartSec=2
LimitNOFILE=65536

# Hardening: the relay needs nothing but a network socket, plus the one
# capability that lets it bind port 443 itself when it terminates TLS.
# `systemd-analyze security silver-relay` scores what is here.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
# The relay has no business reading other processes: /proc shows it its own.
ProtectProc=invisible
ProcSubset=pid
# AF_UNIX for the admin socket.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
RemoveIPC=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Anything the relay creates is its own: the database, the backups, and the
# admin socket, which without this is world-readable for the moment between
# bind() and the chmod that follows it.
UMask=0077

[Install]
WantedBy=multi-user.target
