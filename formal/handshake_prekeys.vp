// handshake.vp with Bob's signed prekeys in the later leak as well: the
// compromise happens before the signed prekeys of the time were rotated
// out (docs/PROTOCOL.md section 8), so both identity keys, both
// Diffie–Hellman identity keys, the signed prekey and the ML-KEM prekey
// are all in the adversary's hands. The relay was honest during the
// handshake (attacker[passive]), so the one-time prekey it served was
// Bob's.
//
// Expected c0a0: confidentiality? m1 holds. Every other input to the
// handshake secret is now computable, and the one-time prekey alone,
// deleted by Bob after use, keeps the message closed: this is what a
// one-time prekey buys (section 2), and handshake_no_opk.vp is the same
// leak without one. An active relay that substituted the one-time prekey
// (add spk_b and pq_b to Bob's leak in handshake.vp to see it) takes that
// protection away, at the price of Bob never reading the message; the
// window closes when the signed prekeys rotate.

attacker[passive]

principal Bob[
    knows public d_bundle, d_spk, d_pq, info_pqxdh, info_root
    knows private ik_b, id_b, spk_b, pq_b
    generates opk_b
    gik_b = PUBKEY(ik_b)
    gid_b = PUBKEY(id_b)
    gspk_b = PUBKEY(spk_b)
    gopk_b = PUBKEY(opk_b)
    ek_b = PUBKEY(pq_b)
    sig_id_b = SIGN(ik_b, HASH(d_bundle, gid_b))
    sig_spk_b = SIGN(ik_b, HASH(d_spk, gspk_b))
    sig_pq_b = SIGN(ik_b, HASH(d_pq, ek_b))
]

Bob -> Alice: [gik_b], gid_b, sig_id_b, gspk_b, sig_spk_b, gopk_b, ek_b, sig_pq_b

principal Alice[
    knows public d_bundle, d_spk, d_pq, info_pqxdh, info_root
    knows private ik_a, id_a
    gik_a = PUBKEY(ik_a)
    gid_a = PUBKEY(id_a)
    sig_id_a = SIGN(ik_a, HASH(d_bundle, gid_a))
    _ = SIGNVERIF(gik_b, HASH(d_bundle, gid_b), sig_id_b)?
    _ = SIGNVERIF(gik_b, HASH(d_spk, gspk_b), sig_spk_b)?
    _ = SIGNVERIF(gik_b, HASH(d_pq, ek_b), sig_pq_b)?
    generates e_a, kem_r, r_a, m1
    ge_a = PUBKEY(e_a)
    gr_a = PUBKEY(r_a)
    ss_a, ct_a = KEM_ENCAP(ek_b, kem_r)
    sk_a = HKDF(nil, HASH(DH_KEX(gspk_b, id_a), DH_KEX(gid_b, e_a), DH_KEX(gspk_b, e_a), DH_KEX(gopk_b, e_a), ss_a), info_pqxdh)
    rk1_a, ck1_a = HKDF(sk_a, DH_KEX(gspk_b, r_a), info_root)
    mk1_a = HKDF(nil, MAC(ck1_a, nil), nil)
    c1 = AEAD_ENC(mk1_a, m1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))
]

Alice -> Bob: [gik_a], gid_a, sig_id_a, ge_a, ct_a, gr_a, c1

principal Bob[
    _ = SIGNVERIF(gik_a, HASH(d_bundle, gid_a), sig_id_a)?
    ss_b = KEM_DECAP(pq_b, ct_a)
    sk_b = HKDF(nil, HASH(DH_KEX(gid_a, spk_b), DH_KEX(ge_a, id_b), DH_KEX(ge_a, spk_b), DH_KEX(ge_a, opk_b), ss_b), info_pqxdh)
    rk1_b, ck1_b = HKDF(sk_b, DH_KEX(gr_a, spk_b), info_root)
    mk1_b = HKDF(nil, MAC(ck1_b, nil), nil)
    m1_b = AEAD_DEC(mk1_b, c1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))?
]

phase[1]

principal Alice[
    leaks ik_a, id_a
]

principal Bob[
    leaks ik_b, id_b, spk_b, pq_b
]

queries[
    confidentiality? m1
    authentication? Alice -> Bob: c1
]
