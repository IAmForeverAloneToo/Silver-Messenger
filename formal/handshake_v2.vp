// The protocol v2 handshake: classical X3DH against Bob's published
// prekeys, no ML-KEM, and the sealed-layer signature over the whole
// envelope instead of a key-binding signature (docs/PROTOCOL.md
// sections 3 and 5). The v3 handshake is this with the ML-KEM secret of
// handshake.vp added, so it is not modelled separately.
//
// The same leak afterwards as in handshake.vp: both identity keys, both
// Diffie–Hellman identity keys, Bob's signed prekey.
//
// Expected c0a0: confidentiality? m1 holds, authentication? c1 holds.
// The envelope signature does for v2 what the key-binding signature does
// for v4; the cost is that Bob can show it to a third party (section 9).

attacker[active]

principal Bob[
    knows public d_bundle, d_spk, d_envelope, info_x3dh, info_root
    knows private ik_b, id_b, spk_b
    generates opk_b
    gik_b = PUBKEY(ik_b)
    gid_b = PUBKEY(id_b)
    gspk_b = PUBKEY(spk_b)
    gopk_b = PUBKEY(opk_b)
    sig_id_b = SIGN(ik_b, HASH(d_bundle, gid_b))
    sig_spk_b = SIGN(ik_b, HASH(d_spk, gspk_b))
]

Bob -> Alice: [gik_b], gid_b, sig_id_b, gspk_b, sig_spk_b, gopk_b

principal Alice[
    knows public d_bundle, d_spk, d_envelope, info_x3dh, info_root
    knows private ik_a, id_a
    gik_a = PUBKEY(ik_a)
    gid_a = PUBKEY(id_a)
    _ = SIGNVERIF(gik_b, HASH(d_bundle, gid_b), sig_id_b)?
    _ = SIGNVERIF(gik_b, HASH(d_spk, gspk_b), sig_spk_b)?
    generates e_a, r_a, m1
    ge_a = PUBKEY(e_a)
    gr_a = PUBKEY(r_a)
    sk_a = HKDF(nil, HASH(DH_KEX(gspk_b, id_a), DH_KEX(gid_b, e_a), DH_KEX(gspk_b, e_a), DH_KEX(gopk_b, e_a)), info_x3dh)
    rk1_a, ck1_a = HKDF(sk_a, DH_KEX(gspk_b, r_a), info_root)
    mk1_a = HKDF(nil, MAC(ck1_a, nil), nil)
    c1 = AEAD_ENC(mk1_a, m1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))
    // The sealed layer: the identity key signs the recipient and the
    // whole body (init header and ratchet message).
    sig_c1 = SIGN(ik_a, HASH(d_envelope, HASH(gik_b, gid_a, ge_a, gr_a, c1)))
]

Alice -> Bob: [gik_a], gid_a, ge_a, gr_a, c1, sig_c1

principal Bob[
    _ = SIGNVERIF(gik_a, HASH(d_envelope, HASH(gik_b, gid_a, ge_a, gr_a, c1)), sig_c1)?
    sk_b = HKDF(nil, HASH(DH_KEX(gid_a, spk_b), DH_KEX(ge_a, id_b), DH_KEX(ge_a, spk_b), DH_KEX(ge_a, opk_b)), info_x3dh)
    rk1_b, ck1_b = HKDF(sk_b, DH_KEX(gr_a, spk_b), info_root)
    mk1_b = HKDF(nil, MAC(ck1_b, nil), nil)
    m1_b = AEAD_DEC(mk1_b, c1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))?
]

phase[1]

principal Alice[
    leaks ik_a, id_a
]

principal Bob[
    leaks ik_b, id_b, spk_b
]

queries[
    confidentiality? m1
    authentication? Alice -> Bob: c1
]
