// Silver Messenger, the protocol v4 handshake: PQXDH against Bob's
// published bundle, the initiator's key-binding signature, and Alice's
// first message under the first ratchet chain (docs/PROTOCOL.md sections
// 5, 6 and 4.2.1). Verifpal 1.4.
//
// Names follow the protocol document: ik is an identity (signing) key,
// id the long-term Diffie–Hellman key, spk the signed prekey, opk the
// one-time prekey, pq the ML-KEM prekey (its public half ek), e Alice's
// ephemeral, r the first ratchet key. The d_* constants are the signature
// domains and the info_* constants the HKDF infos; the salts, the 0xFF
// prefix and the chain-KDF byte are constants too and are left out. The
// session id in the associated data is left out as well: it is a hash of
// the ephemeral and the signed prekey, both already bound into the key.
//
// The guarded values ([..]) are the two identity keys: each side has the
// other's id pinned, and the id is the key. Everything else goes through
// the relay, which is the attacker. Bob's one-time prekey is unsigned, as
// on the wire; the attacker may replace it.
//
// After the handshake (phase 1) every long-term secret leaks: both
// identity keys and both Diffie–Hellman identity keys. Bob's signed
// prekeys, which rotate and are deleted (section 8), the one-time prekey
// (deleted after use) and Alice's ephemeral and ratchet keys do not;
// handshake_prekeys.vp and handshake_no_opk.vp add the signed prekeys to
// the leak.
//
// Expected c0a0: confidentiality? m1 holds (a later compromise of the
// long-term keys does not open the handshake), authentication? c1 holds
// (the attacker cannot make Bob accept a first message as Alice's, nor
// make him accept one twice: his one-time prekey is fresh per run).

attacker[active]

principal Bob[
    knows public d_bundle, d_spk, d_pq, info_pqxdh, info_root
    knows private ik_b, id_b, spk_b, pq_b
    generates opk_b
    gik_b = PUBKEY(ik_b)
    gid_b = PUBKEY(id_b)
    gspk_b = PUBKEY(spk_b)
    gopk_b = PUBKEY(opk_b)
    ek_b = PUBKEY(pq_b)
    sig_id_b = SIGN(ik_b, HASH(d_bundle, gid_b))
    sig_spk_b = SIGN(ik_b, HASH(d_spk, gspk_b))
    sig_pq_b = SIGN(ik_b, HASH(d_pq, ek_b))
]

// The bundle, as the relay serves it on lookup.
Bob -> Alice: [gik_b], gid_b, sig_id_b, gspk_b, sig_spk_b, gopk_b, ek_b, sig_pq_b

principal Alice[
    knows public d_bundle, d_spk, d_pq, info_pqxdh, info_root
    knows private ik_a, id_a
    gik_a = PUBKEY(ik_a)
    gid_a = PUBKEY(id_a)
    sig_id_a = SIGN(ik_a, HASH(d_bundle, gid_a))
    _ = SIGNVERIF(gik_b, HASH(d_bundle, gid_b), sig_id_b)?
    _ = SIGNVERIF(gik_b, HASH(d_spk, gspk_b), sig_spk_b)?
    _ = SIGNVERIF(gik_b, HASH(d_pq, ek_b), sig_pq_b)?
    generates e_a, kem_r, r_a, m1
    ge_a = PUBKEY(e_a)
    gr_a = PUBKEY(r_a)
    ss_a, ct_a = KEM_ENCAP(ek_b, kem_r)
    sk_a = HKDF(nil, HASH(DH_KEX(gspk_b, id_a), DH_KEX(gid_b, e_a), DH_KEX(gspk_b, e_a), DH_KEX(gopk_b, e_a), ss_a), info_pqxdh)
    rk1_a, ck1_a = HKDF(sk_a, DH_KEX(gspk_b, r_a), info_root)
    mk1_a = HKDF(nil, MAC(ck1_a, nil), nil)
    c1 = AEAD_ENC(mk1_a, m1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))
]

// The init header (identity_dh, its key-binding signature, the
// ephemeral, the ML-KEM ciphertext) and the first ratchet message.
Alice -> Bob: [gik_a], gid_a, sig_id_a, ge_a, ct_a, gr_a, c1

principal Bob[
    _ = SIGNVERIF(gik_a, HASH(d_bundle, gid_a), sig_id_a)?
    ss_b = KEM_DECAP(pq_b, ct_a)
    sk_b = HKDF(nil, HASH(DH_KEX(gid_a, spk_b), DH_KEX(ge_a, id_b), DH_KEX(ge_a, spk_b), DH_KEX(ge_a, opk_b), ss_b), info_pqxdh)
    rk1_b, ck1_b = HKDF(sk_b, DH_KEX(gr_a, spk_b), info_root)
    mk1_b = HKDF(nil, MAC(ck1_b, nil), nil)
    m1_b = AEAD_DEC(mk1_b, c1, HASH(gik_a, gid_a, gik_b, gid_b, gr_a))?
]

phase[1]

principal Alice[
    leaks ik_a, id_a
]

principal Bob[
    leaks ik_b, id_b
]

queries[
    confidentiality? m1
    authentication? Alice -> Bob: c1
]
