# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# Fuzzing: build output, crashes and the corpus libfuzzer grows
fuzz/target
fuzz/artifacts
fuzz/corpus

# Python's bytecode cache, from tests/tui and tests/docs
__pycache__/
*.py[cod]

# Release binaries staged for a container build (deploy/Dockerfile)
prebuilt/

# A relay run from the checkout keeps its data in ./silver-relay-data: the
# database, its backups, and under acme/ the ACME account key and the
# certificate's private key. Never to be committed, wherever they land.
silver-relay-data/
*.redb
*.backup

# Private keys and certificates: a relay's --tls-cert and --tls-key, or a
# signing key made with SILVER_KEY_DIR pointed here. The public signing key
# is minisign.pub, which is not matched.
*.pem
*.key

# Environment files, where SILVER_PASSPHRASE and its kind would sit
.env
.env.*

# Packages built by packaging/deb/build.sh with the checkout as the output
*.deb

# Editors and operating systems
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini
